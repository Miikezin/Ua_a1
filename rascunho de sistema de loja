      "source": [
        "def calcular_desconto(valor, percentual):\n",
        "    \"\"\"Calcula o valor final aplicando um valor percentual.\"\"\"\n",
        "    if percentual < 0 or percentual > 100:\n",
        "        return None # marcação inválida\n",
        "    desconto = valor * (percentual / 100)\n",
        "    return valor - desconto\n",
        "\n",
        "def registrar_venda(produto, valor_final):\n",
        "    \"\"\"Imprime o registro de uma venda\"\"\"\n",
        "    print(f\"produto: {produto}\")\n",
        "    print(f\"valor final: {valor_final:.2f}\")\n",
        "\n",
        "\n",
        "# funçao lambda para arredondar\n",
        "\n",
        "arredondar = lambda v: round(v, 2)"
      ],
      "metadata": {
        "id": "lyHbOnuKf_CW"
      },
      "execution_count": 2,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#variaveis principais do tdv\n",
        "total_vendas = 0\n",
        "quantidade_vendas = 0\n"
      ],
      "metadata": {
        "id": "_51pwZJejqzK"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#loop principal do caixa.minha loja pdv\n",
        "while True:\n",
        "  print(\"\\n---1 - minha loja - pdv---\")\n",
        "  print(\"2 - registrar venda\")\n",
        "  print(\"3 - ver relatório do dia\")\n",
        "  print(\"4 - encerrar caixa\")\n",
        "\n",
        "  opcao = input(\"Digite a opção desejada: \")\n",
        "\n",
        "  if opcao == '4': # Corresponds to \"4 - encerrar caixa\"\n",
        "    print(\"Encerrando caixa.\")\n",
        "    break\n",
        "  elif opcao == \"2\": # Corresponds to \"2 - registrar venda\"\n",
        "    produto = input(\"digite o nome do produto: \")\n",
        "    valor = float(input(\"digite o valor do produto: \"))\n",
        "    percentual = float(input(\"digite o percentual de desconto: \"))\n",
        "\n",
        "    valor_final = calcular_desconto(valor, percentual)\n",
        "    if valor_final is None:\n",
        "      print(\"valor invalido (percentual deve estar entre 0 e 100).\")\n",
        "    else:\n",
        "      valor_final = arredondar(valor_final)\n",
        "      registrar_venda(produto, valor_final)\n",
        "      total_vendas += valor_final\n",
        "      quantidade_vendas += 1\n",
        "  elif opcao == \"3\": # Corresponds to \"3 - ver relatório do dia\"\n",
        "    print(f\"\\nvendas hoje: {quantidade_vendas}\")\n",
        "    print(f\"total faturado: R$ {arredondar(total_vendas):.2f}\")\n",
        "  else:\n",
        "    print(\"Opção inválida, tente novamente.\")"
      ],
